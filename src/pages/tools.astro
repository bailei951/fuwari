---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const tools = [
    {
        name: "服装品牌设计 · 答题测试",
        description: "单文件版服装品牌设计答题测试，无需加载额外资源，适合快速访问与离线使用。",
        url: "/quiz-app.html",
        icon: "fa6-solid:shirt",
    },
    {
        name: "数据结构 · 刷题工具",
        description: "涵盖线性表、栈队列、串、树、图、排序、查找等全部章节，共 837 道判断题与单选题，支持章节筛选、错题专项练习、随机考试，含 LaTeX 数学公式渲染。",
        url: "/tools/data-structure/",
        icon: "fa6-solid:diagram-project",
    },
    {
        name: "BS架构课程 · 答题测试",
        description: "BS架构课程在线答题测试工具，涵盖前后端架构、HTTP协议、Web安全等核心知识点，支持刷题模式与随机考试。",
        url: "/tools/fashion-quiz/",
        icon: "fa6-solid:server",
    },
    {
        name: "创新创业 · 离线做题",
        description: "创新创业课程在线刷题工具，支持判断题、单选题、多选题，含刷题模式与随机考试模式，自动记录错题与答题进度。",
        url: "/tools/chuangxin/",
        icon: "fa6-solid:lightbulb",
    },
    {
        name: "高考志愿填报综合分析报告",
        description: "三份专业报告整合研究，涵盖高考志愿填报策略、专业选择与院校分析的综合参考文档。",
        url: "/tools/gaokao-report/",
        icon: "fa6-solid:graduation-cap",
    },
    {
        name: "湖南服装设计专升本报考指南 🔐",
        description: "2026年湖南省服装设计类专科生专升本报考指南，含院校分析、考试科目、录取数据与备考策略（访问需密钥）。",
        url: "/tools/zhuanshengben/",
        icon: "fa6-solid:book",
    },
    {
        name: "两栖爬行动物类健康提升指南 🔐",
        description: "两栖爬行动物类健康管理参考指南，涵盖饮食营养、环境调控、疾病预防等综合健康提升方案（访问需密钥）。",
        url: "/tools/jiankang/",
        icon: "fa6-solid:heart-pulse",
    },
];
---
<MainGridLayout title="工具" description="实用工具集合">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <h2 class="text-2xl font-bold mb-6 dark:text-neutral-50 transition">🛠️ 实用工具</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {tools.map(tool => (
                    <a href={tool.url} data-no-swup
                       class="card-base p-5 rounded-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 group no-underline">
                        <div class="flex items-start gap-4">
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-[var(--primary)]/10 flex items-center justify-center group-hover:bg-[var(--primary)]/20 transition-colors">
                                <Icon name={tool.icon} class="text-2xl text-[var(--primary)]" />
                            </div>
                            <div class="min-w-0">
                                <h3 class="font-bold text-lg mb-1.5 group-hover:text-[var(--primary)] dark:text-neutral-100 transition-colors">{tool.name}</h3>
                                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed transition">{tool.description}</p>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
            {tools.length === 0 && (
                <div class="text-center py-16 text-neutral-400 dark:text-neutral-500">
                    <Icon name="fa6-solid:hammer" class="text-5xl mb-4 opacity-30" />
                    <p class="text-lg">暂无工具，敬请期待</p>
                </div>
            )}
        </div>
    </div>
</MainGridLayout>
